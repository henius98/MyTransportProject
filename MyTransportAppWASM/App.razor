@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader LazyAssemblyLoader

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" OnNavigateAsync="PrepareRouteAsync">
        <Found Context="routeData">
            <!-- All routes are public, so no Authorizing message is shown; Firebase sign-in stays in the account UI. -->
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <MyTransportAppWASM.Pages.Core.NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _gtfsAssemblyLoaded;

    private async Task PrepareRouteAsync(NavigationContext navigation)
    {
        var route = navigation.Path.Trim('/').Split('?', '#')[0];
        if (_gtfsAssemblyLoaded ||
            !string.Equals(route, "map", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await LazyAssemblyLoader.LoadAssembliesAsync(["MyTransportAppWASM.Gtfs.dll"]);
        _gtfsAssemblyLoaded = true;
    }
}
