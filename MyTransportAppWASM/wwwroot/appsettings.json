{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authorization": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleMaps": {
    "ApiKey": "__GOOGLE_MAPS_API_KEY__"
  },
  "Firebase": {
    "apiKey": "",
    "authDomain": "",
    "projectId": "",
    "appId": "",
    "googleClientId": "",
    "webPushVapidKey": ""
  },
  "CacheExpiration": {
    "Weather": {
      "LiveSeconds": 600,
      "OutlookSeconds": 10800,
      "FallbackSeconds": 30
    },
    "Map": {
      "GeolocationSeconds": 60
    }
  },
  "WeatherProviders": {
    "MetMalaysia": {
      "Enabled": true,
      "Name": "MetMalaysia",
      "Source": "data.gov.my",
      "BaseUrl": "https://api.data.gov.my/weather/forecast",
      "Endpoints": "?contains={location_id}@location__location_id&date_start={date_start}@date&date_end={date_end}@date&exclude=summary_forecast,summary_when"
    },
    "SingaporeNEA": {
      "Enabled": true,
      "Name": "Singapore NEA",
      "Source": "data.gov.sg",
      "BaseUrl": "https://api-open.data.gov.sg/v2/real-time/api",
      "Endpoints": {
        "Realtime": "/two-hr-forecast",
        "Outlook": "/four-day-outlook"
      }
    },
    "OpenMeteo": {
      "Enabled": true,
      "Name": "Open-Meteo",
      "Source": "open-meteo.com",
      "BaseUrl": "https://api.open-meteo.com/v1/forecast",
      "Endpoints": {
        "Realtime": "?latitude={lat}&longitude={lon}&current_weather=true&hourly=temperature_2m,precipitation_probability,precipitation,weather_code&forecast_hours={forecast_hours}&timezone=auto",
        "Outlook": "?latitude={lat}&longitude={lon}&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,wind_speed_10m_max,uv_index_max,sunrise,sunset,weather_code&forecast_days={forecast_days}&timezone=auto",
        "Hourly": "?latitude={lat}&longitude={lon}&hourly=temperature_2m,precipitation_probability,precipitation,weather_code,wind_speed_10m&start_date={date}&end_date={date}&timezone={timezone}"
      }
    }
  },
  "TransitPolling": {
    "IntervalSeconds": 15,
    "MaximumBackoffSeconds": 120,
    "MaximumSnapshotAgeSeconds": 120
  },
  "TransportProviders": [
