@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject FirebaseClientService Firebase
@inject AppStateService AppState
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthSessionService AuthSession
@inject IUserSettingsService UserSettings

@implements IDisposable

<div class="@ContainerClass">
  <div class="top-row ps-3 navbar">
    <div class="container-fluid d-flex justify-content-start align-items-center flex-nowrap">
      <div class="profile me-3 position-relative" @onclick="() => { }" @onclick:stopPropagation="true">
        <button type="button" class="btn profile__trigger" @onclick="ToggleUserMenu"
                aria-label="@Language["UserProfile"]" title="@Language["UserProfile"]">
          <AuthorizeView>
            <Authorized>
              @if (context.User.GetPictureUrl() is { Length: > 0 } avatarUrl)
              {
                <img src="@avatarUrl" class="avatar avatar--sm" alt="@Language["UserProfile"]" />
              }
              else
              {
                <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span>
              }
            </Authorized>
            <NotAuthorized>
              <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span>
            </NotAuthorized>
          </AuthorizeView>
        </button>

        @if (showUserMenu)
        {
          <div class="dropdown__overlay" @onclick="ToggleUserMenu"></div>
          <div class="user-menu-dropdown p-3 shadow-lg">
            <AuthorizeView>
              <Authorized>
                <div class="d-flex align-items-center mb-3">
                  @if (context.User.GetPictureUrl() is { Length: > 0 } menuAvatarUrl)
                  {
                    <img src="@menuAvatarUrl" class="avatar avatar--lg me-3" alt="@Language["UserProfile"]" />
                  }
                  <div class="text-truncate">
                    <div class="profile__name fw-bold">@(context.User?.Identity?.Name ?? "User")</div>
                    <div class="text-muted text--xs text-truncate">
                      @(context.User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</div>
                    </div>
                  </div>
                  <small class="text-muted d-block mb-2">@Language["SignedInWithGoogle"]</small>
                  <hr class="my-2 border-secondary" />
                </Authorized>
              </AuthorizeView>

              <div class="mb-3 mt-1">
                <small class="menu-section-label">@Language["Preferences"]</small>

                <div class="switch-group d-flex align-items-center justify-content-between p-2 rounded mb-2">
                  <div class="d-flex align-items-center">
                    <span class="bi bi-moon-stars-fill-nav-menu me-2" aria-hidden="true"></span>
                    <span class="switch-group__label">@(Theme.IsDarkMode ? Language["DarkMode"] :
                  Language["LightMode"])</span>
                    </div>
                    <div class="form-check form-switch m-0">
                      <input class="form-check-input switch shadow-none" type="checkbox" role="switch"
                             aria-label="@Language["ToggleDarkMode"]" checked="@Theme.IsDarkMode" @onchange="Theme.ToggleThemeAsync" />
                    </div>
                  </div>

                  <div class="switch-group d-flex align-items-center justify-content-between p-2 rounded">
                    <LanguageSwitcher @key="Language.CurrentLanguageName" />
                  </div>
                </div>

                <hr class="my-2 border-secondary" />

                @if (!string.IsNullOrEmpty(UserSettings.SyncError))
                {
                  <p class="text-warning small" role="status" aria-live="polite">@UserSettings.SyncError</p>
                }
                @if (!string.IsNullOrEmpty(logoutError))
                {
                  <p class="text-danger small" role="alert">@logoutError</p>
                }

                <AuthorizeView>
                  <Authorized>
                    <button type="button" class="nav-link btn btn--secondary menu-action-btn w-100 mb-1" disabled="@pushBusy"
                            @onclick="TogglePushNotifications">
                      <span class="bi bi-bell me-2" aria-hidden="true"></span>
                      @(pushStatus == "enabled" ? Language["DisableNotifications"] : Language["EnableNotifications"])
                    </button>
                    @if (!string.IsNullOrEmpty(pushError))
                    {
                      <p class="text-warning small" role="alert">@pushError</p>
                    }
                  </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                  <Authorized>
                    <button type="button" class="nav-link btn btn--secondary menu-action-btn w-100" disabled="@isLoggingOut" @onclick="BeginLogOut">
                      <span class="bi bi-box-arrow-right-nav-menu me-2" aria-hidden="true"></span> @Language["LogOut"]
                    </button>
                  </Authorized>
                  <NotAuthorized>
                    <button type="button" class="nav-link btn btn--secondary menu-action-btn w-100" @onclick="BeginLogin">
                      <span class="bi bi-box-arrow-in-right-nav-menu me-2" aria-hidden="true"></span> @Language["LogIn"]
                    </button>
                  </NotAuthorized>
                </AuthorizeView>
              </div>
            }
          </div>
          <a class="navbar-brand text-truncate" href="">MyTransportApp</a>
        </div>
      </div>

      <label for="nav-toggler" class="visually-hidden">@Language["ToggleNavigationMenu"]</label>
      <input id="nav-toggler" type="checkbox" aria-label="@Language["ToggleNavigationMenu"]" title="@Language["ToggleNavigationMenu"]"
             class="navbar-toggler" />

      <div class="nav-scrollable">
        <nav class="nav flex-column" aria-label="Main navigation" @onclick="CollapseNav" @onclick:stopPropagation="true">
          <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
              <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
              <span class="nav-text ms-2">@Language["Home"]</span>
            </NavLink>
          </div>

          <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
              <span class="bi bi-cloud-sun-fill-nav-menu" aria-hidden="true"></span>
              <span class="nav-text ms-2">@Language["Weather"]</span>
            </NavLink>
          </div>

          <div class="nav-item px-3">
            <NavLink class="nav-link" href="map">
              <span class="bi bi-geo-alt-fill-nav-menu" aria-hidden="true"></span>
              <span class="nav-text ms-2">@Language["Map"]</span>
            </NavLink>
          </div>

          <div class="nav-item px-3">
            <NavLink class="nav-link" href="fortune">
              <span class="bi bi-brilliance-nav-menu" aria-hidden="true"></span>
              <span class="nav-text ms-2">@Language["Fortune"]</span>
            </NavLink>
          </div>
          <AuthorizeView>
            <Authorized>
              <div class="nav-item px-3">
                <NavLink class="nav-link" href="google/calendar">
                  <span class="bi bi-calendar3" aria-hidden="true"></span>
                  <span class="nav-text ms-2">@Language["Calendar"]</span>
                </NavLink>
              </div>
              <div class="nav-item px-3">
                <NavLink class="nav-link" href="google/tasks">
                  <span class="bi bi-check2-square" aria-hidden="true"></span>
                  <span class="nav-text ms-2">@Language["Tasks"]</span>
                </NavLink>
              </div>
            </Authorized>
          </AuthorizeView>
          <div class="nav-item nav-item--keep px-3">
            <a class="nav-link" href="https://keep.google.com/" target="_blank" rel="noopener noreferrer"
               title="@Language["AddKeepNote"]">
              <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
              <span class="nav-text ms-2">@Language["AddKeepNote"] ↗</span>
            </a>
          </div>
        </nav>
      </div>
    </div>

@code {
  [Parameter] public bool IsCollapsed { get; set; }
  [CascadingParameter] private ThemeService Theme { get; set; } = default!;
  [CascadingParameter] private LanguageService Language { get; set; } = default!;
  private string ContainerClass => $"nav-menu-container {(IsCollapsed ? "collapsed" : "")}".Trim();
  private bool showUserMenu;
  private bool isLoggingOut;
  private string? logoutError;
  private bool pushBusy;
  private string pushStatus = "disabled";
  private string? pushError;

  protected override void OnInitialized()
  {
    UserSettings.SyncStatusChanged += HandleSyncStatusChanged;
  }

  private async Task<string?> GetCurrentUserIdAsync()
  {
    var state = await AuthStateProvider.GetAuthenticationStateAsync();
    return state.User.GetUserId();
  }

  private async Task ToggleUserMenu()
  {
    showUserMenu = !showUserMenu;
    if (!showUserMenu) return;
    pushError = null;
    try
    {
      pushStatus = await Firebase.GetPushStatusAsync(await GetCurrentUserIdAsync());
    }
    catch (JSException)
    {
      pushStatus = "unsupported";
    }
  }

  private async Task TogglePushNotifications()
  {
    pushBusy = true;
    pushError = null;
    try
    {
      if (pushStatus is "unsupported" or "denied")
      {
        pushError = pushStatus == "denied" ? Language["NotificationsDenied"] : Language["NotificationsUnsupported"];
        return;
      }
      var uid = await GetCurrentUserIdAsync();
      if (uid is null) return;
      if (pushStatus == "enabled")
        await Firebase.DisablePushAsync(uid);
      else
        await Firebase.EnablePushAsync(uid);
      pushStatus = pushStatus == "enabled" ? "disabled" : "enabled";
    }
    catch (JSException)
    {
      if (pushStatus == "enabled")
      {
        pushError = Language["DisableNotificationsFailed"];
      }
      else
      {
        try
        {
          pushStatus = await Firebase.GetPushStatusAsync(await GetCurrentUserIdAsync());
        }
        catch (JSException)
        {
          pushStatus = "unsupported";
        }

        pushError = pushStatus switch
        {
          "denied" => Language["NotificationsDenied"],
          "unsupported" => Language["NotificationsUnsupported"],
          _ => Language["EnableNotificationsFailed"]
        };
      }
    }
    finally
    {
      pushBusy = false;
    }
  }

  private void BeginLogin() => AppState.RequestShowLogin(Navigation.Uri);

  private async Task BeginLogOut()
  {
    isLoggingOut = true;
    logoutError = null;
    try
    {
      await AuthSession.SignOutAsync();
      showUserMenu = false;
    }
    catch (JSException)
    {
      logoutError = Language["SignOutFailed"];
    }
    finally
    {
      isLoggingOut = false;
    }
  }

  private void HandleSyncStatusChanged() => _ = InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    UserSettings.SyncStatusChanged -= HandleSyncStatusChanged;
  }

  private Task CollapseNav() =>
    JS.TryInvokeVoidSafeAsync("navigationHelper.collapseMobileMenu");
}
