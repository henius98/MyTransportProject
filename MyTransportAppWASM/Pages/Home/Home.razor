@page "/"
@page "/index.html"
@using MyTransportAppWASM.Services
@using MyTransportAppWASM.Services.Interfaces
@inject IUserSettingsService UserSettings

<PageTitle>Home - MyTransportApp</PageTitle>

<div class="hero">
    <div class="hero__content">
        <h1 class="section-title">Ready for your next journey?</h1>
        <p class="section-subtitle">Track real-time bus locations and plan your trips with live weather insights across
            Malaysia.</p>

            <div class="dashboard">
                <a class="card card-map dashboard__link" href="map">
                    <div class="dashboard__icon">📍</div>
                    <h3>Live Bus Map</h3>
                    <p>Track rapid bus positions in real-time on our interactive map.</p>
                    <div class="dashboard__footer">
                        <span class="dash-link">Open Map</span>
                        <span class="arrow">&rarr;</span>
                    </div>
                </a>

                <a class="card card-weather dashboard__link" href="weather">
                    <div class="dashboard__icon">🌦️</div>
                    <h3>Weather Planner</h3>
                    <p>Get precise weather forecasts for your departure and return.</p>
                    <div class="dashboard__footer">
                        <span class="dash-link">Plan Trip</span>
                        <span class="arrow">&rarr;</span>
                    </div>
                </a>
            </div>

            <footer class="mt-4 text-center">
                <a href="privacy" class="text-muted small text-decoration-none" style="opacity: 0.7;">Privacy Policy</a>
            </footer>
        </div>
    </div>

    @if (showWelcome)
    {
        <div class="modal__backdrop" @onclick="CloseWelcome" @onclick:stopPropagation="true">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="welcome-title" @onclick:stopPropagation="true">
                <button type="button" class="modal__close" aria-label="Close welcome" @onclick="CloseWelcome">&times;</button>
                <div class="modal__icon">👋</div>
                <h2 id="welcome-title" class="fw-bold">Welcome to MyTransportApp!</h2>
                <p>Your ultimate companion for navigating public transport in Malaysia, Singapore. We've combined real-time GTFS
                    data with precise weather modeling.</p>

                    <div class="stats mb-3">
                        <div class="stats__item">
                            <span class="stats__value">@factor</span>
                            <span class="stats__label">Form Factor</span>
                        </div>
                        <div class="stats__divider"></div>
                        <div class="stats__item">
                            <span class="stats__value">@platform</span>
                            <span class="stats__label">Platform</span>
                        </div>
                    </div>

                    <button class="btn btn btn--primary w-100" @onclick="CloseWelcome">Let's Get Started!</button>
                </div>
            </div>
        }



@code {
    private const string factor = "WebAssembly";
    private const string platform = "Blazor WebAssembly";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool showWelcome;
    private int welcomeVersion;
    private Task<AuthenticationState>? _lastAuthState;
    private bool _initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && ReferenceEquals(AuthState, _lastAuthState))
        {
            return;
        }

        _initialized = true;
        _lastAuthState = AuthState;
        var version = ++welcomeVersion;
        if (AuthState is not null)
        {
            await AuthState;
        }
        var settings = await UserSettings.GetSettingsAsync();
        if (version != welcomeVersion) return;
        showWelcome = settings.HasSeenWelcome != true;
    }

    private async Task CloseWelcome()
    {
        showWelcome = false;
        await UserSettings.UpdateHasSeenWelcomeAsync(true);
    }
}
