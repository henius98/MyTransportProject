@using MyTransportAppWASM.Models

@if (RouteOptions != null && RouteOptions.Count > 0)
{
    <div class="route-options mt-3" style="max-height: 300px; overflow-y: auto;">
        <h3 class="fs-6 mb-2">Live Route Options</h3>
        @foreach (var route in RouteOptions)
        {
            <button type="button" @key="route.OriginalRoute.RouteId"
                    class="route-option card mb-2 p-2 shadow-sm @(route.HasLiveBus ? "border-success" : "") @(route.OriginalRoute.RouteId == ActiveRouteId ? "border-primary border-2 shadow" : "")"
                    aria-pressed="@(route.OriginalRoute.RouteId == ActiveRouteId)"
                    @onclick="() => OnSelectRoute.InvokeAsync(route)">
                <div class="d-flex justify-content-between align-items-center">
                    <strong style="color: var(--text-color);">Option @(route.OriginalRoute.RouteId + 1)</strong>
                    <div>
                        @if (route.IsAuspicious)
                        {
                            <span class="badge bg-warning text-dark me-1" title="Aligns with lucky directions or times">🌟 Auspicious</span>
                        }
                        <span class="badge @(route.HasLiveBus ? "bg-success" : "bg-secondary")">
                            @(route.HasLiveBus ? "Live" : "Scheduled")
                        </span>
                    </div>
                </div>
                <div class="small mt-1" style="color: var(--text-muted);">
                    <div>Base ETA: @(route.OriginalRoute.DurationSeconds / 60) mins</div>
                    @if (route.HasLiveBus)
                    {
                        <div class="text-success fw-bold">Live ETA: @(route.LiveTotalDurationSeconds / 60) mins</div>
                    }
                </div>
                @if (route.NearestBuses.Any())
                {
                    <div class="small mt-1" style="color: var(--text-muted);">
                        @foreach (var bus in route.NearestBuses)
                        {
                            <div>Bus <strong>@bus.RouteId</strong> is @((int)bus.DistanceToStopMeters)m away</div>
                        }
                    </div>
                }
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<EnrichedRoute> RouteOptions { get; set; } = [];

    [Parameter, EditorRequired]
    public int ActiveRouteId { get; set; } = -1;

    [Parameter]
    public EventCallback<EnrichedRoute> OnSelectRoute { get; set; }
}
