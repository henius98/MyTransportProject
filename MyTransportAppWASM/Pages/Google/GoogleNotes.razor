@page "/google/notes"

<GoogleServicePage Title="Keep notes" Description="Your ideas and checklists, ready for the next journey.">
    <ChildContent Context="uid">
        <section class="google-panel google-keep">
            <span class="bi bi-sticky google-service-icon" aria-hidden="true"></span>
            <h2>View and edit your notes in Google Keep</h2>
            <p>Google Keep notes for personal accounts can't be loaded or edited inside this app. Open Keep to work with your existing notes.</p>
            <a href="https://keep.google.com/" target="_blank" rel="noopener noreferrer" class="btn btn--primary">Open Google Keep ↗</a>
            <p class="google-muted">Opens in a new tab. If you use multiple Google accounts, choose the same account in Keep.</p>
        </section>
    </ChildContent>
</GoogleServicePage>
