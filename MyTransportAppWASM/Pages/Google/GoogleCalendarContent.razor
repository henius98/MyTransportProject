@using System.Globalization
@implements IDisposable
@inject GoogleWorkspaceService Workspace

<div class="google-toolbar">
    <div class="google-field">
        <label for="google-calendar-choice">Calendar</label>
        <select id="google-calendar-choice" class="form-select" @bind:get="calendarId" @bind:set="ChangeCalendarAsync" disabled="@(busy || calendars.Count == 0)">
            @foreach (var calendar in calendars)
            {
                <option value="@calendar.Id">@calendar.Summary@(calendar.Primary ? " (primary)" : "")</option>
            }
        </select>
    </div>
    <div class="google-field">
        <label for="google-calendar-from">From</label>
        <input id="google-calendar-from" class="form-control" type="date" @bind="rangeStart" disabled="@busy" />
    </div>
    <div class="google-field">
        <label for="google-calendar-through">Through</label>
        <input id="google-calendar-through" class="form-control" type="date" @bind="rangeEnd" disabled="@busy" />
    </div>
    <button type="button" class="btn btn--secondary" @onclick="RefreshAsync" disabled="@busy">@(busy ? "Loading…" : "Refresh events")</button>
</div>

<p class="google-muted">Event times use your device time zone: @TimeZoneInfo.Local.DisplayName. All-day dates include the last day shown. Refreshing reloads the selected event's details.</p>
@if (!string.IsNullOrEmpty(error))
{
    <p class="google-error" role="alert">@error</p>
}
@if (!string.IsNullOrEmpty(status))
{
    <p class="google-status" role="status">@status</p>
}

<div class="google-grid" aria-busy="@busy">
    <section class="google-panel" aria-labelledby="google-agenda-title">
        <div class="google-toolbar">
            <h2 id="google-agenda-title">Your agenda</h2>
            <button type="button" class="btn btn--primary" @onclick="NewEvent" disabled="@(busy || !CanWrite)">New event</button>
        </div>
        @if (busy && events.Count == 0)
        {
            <p class="google-empty" role="status">Loading your events…</p>
        }
        else if (calendars.Count == 0)
        {
            <p class="google-empty">No calendars are available. Try refreshing or reconnecting your account.</p>
        }
        else if (events.Count == 0)
        {
            <p class="google-empty">No events in this date range.</p>
        }
        else
        {
            <ul class="google-list">
                @foreach (var entry in events)
                {
                    <li class="google-list-item" @key="entry.Id">
                        <button type="button" class="btn btn--secondary" @onclick="() => SelectEvent(entry)" disabled="@busy" aria-pressed="@(selectedEvent?.Id == entry.Id)">@(string.IsNullOrWhiteSpace(entry.Summary) ? "Untitled event" : entry.Summary)</button>
                        <p class="google-muted">@EventWhen(entry)</p>
                        @if (!string.IsNullOrEmpty(entry.Location))
                        {
                            <p>@entry.Location</p>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="google-panel" aria-labelledby="google-event-editor-title">
        <h2 id="google-event-editor-title">@(selectedEvent == null ? "New event" : "Event details")</h2>
        @if (!CanWrite)
        {
            <p class="google-muted">This calendar is read-only. You can view events here.</p>
        }
        else if (selectedEvent != null && !CanEdit)
        {
            <p class="google-muted">Manage this special or locked event in Google Calendar.</p>
        }
        @if (!string.IsNullOrEmpty(selectedEvent?.RecurringEventId))
        {
            <p class="google-muted">Changes here affect only this occurrence of the recurring event.</p>
        }
        @if (!string.IsNullOrEmpty(selectedEvent?.HtmlLink))
        {
            <p><a href="@selectedEvent.HtmlLink" target="_blank" rel="noopener noreferrer">Open in Google Calendar ↗</a></p>
        }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <fieldset class="google-editor" disabled="@(busy || !CanEdit)">
                <div class="google-field">
                    <label for="google-event-title">Title</label>
                    <input id="google-event-title" class="form-control" @bind="title" required />
                </div>
                <label><input type="checkbox" @bind="allDay" /> All day</label>
                @if (allDay)
                {
                    <div class="google-field">
                        <label for="google-event-start-date">First day</label>
                        <input id="google-event-start-date" class="form-control" type="date" @bind="startsAt" required />
                    </div>
                    <div class="google-field">
                        <label for="google-event-end-date">Last day</label>
                        <input id="google-event-end-date" class="form-control" type="date" @bind="endsAt" required />
                    </div>
                }
                else
                {
                    <div class="google-field">
                        <label for="google-event-start-time">Starts</label>
                        <input id="google-event-start-time" class="form-control" type="datetime-local" @bind="startsAt" required />
                    </div>
                    <div class="google-field">
                        <label for="google-event-end-time">Ends</label>
                        <input id="google-event-end-time" class="form-control" type="datetime-local" @bind="endsAt" required />
                    </div>
                }
                <div class="google-field">
                    <label for="google-event-location">Location</label>
                    <input id="google-event-location" class="form-control" @bind="location" />
                </div>
                <div class="google-field">
                    <label for="google-event-description">Description</label>
                    <textarea id="google-event-description" class="form-control" rows="4" @bind="description"></textarea>
                </div>
                <div class="google-actions">
                    <button type="submit" class="btn btn--primary">@(busy ? "Please wait…" : selectedEvent == null ? "Create event" : "Save changes")</button>
                    @if (selectedEvent != null)
                    {
                        <button type="button" class="btn btn--secondary" @onclick="() => confirmDelete = true">Delete</button>
                    }
                </div>
                @if (confirmDelete)
                {
                    <div class="google-status" role="alert">
                        <p>Delete @(string.IsNullOrEmpty(selectedEvent?.RecurringEventId) ? "this event" : "this occurrence") from your Google calendar?</p>
                        <div class="google-actions">
                            <button type="button" class="btn btn--secondary" @onclick="DeleteAsync">Yes, delete</button>
                            <button type="button" class="btn btn--secondary" @onclick="() => confirmDelete = false">Keep event</button>
                        </div>
                    </div>
                }
            </fieldset>
        </form>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string UserId { get; set; } = string.Empty;

    private List<MyTransportAppWASM.Models.GoogleCalendar> calendars = [];
    private List<GoogleCalendarEvent> events = [];
    private string calendarId = string.Empty;
    private DateTime rangeStart = DateTime.Today;
    private DateTime rangeEnd = DateTime.Today.AddDays(30);
    private DateTime loadedStart;
    private DateTime loadedEnd;
    private GoogleCalendarEvent? selectedEvent;
    private string title = string.Empty;
    private string description = string.Empty;
    private string location = string.Empty;
    private DateTime startsAt;
    private DateTime endsAt;
    private bool allDay;
    private bool busy;
    private bool disposed;
    private bool confirmDelete;
    private string? error;
    private string? status;

    private bool CanWrite => calendars.FirstOrDefault(calendar => calendar.Id == calendarId)?.AccessRole is "owner" or "writer";
    private bool CanEdit => CanWrite && (selectedEvent == null || (!selectedEvent.Locked && (string.IsNullOrEmpty(selectedEvent.EventType) || selectedEvent.EventType == "default")));

    protected override async Task OnInitializedAsync()
    {
        NewEvent();
        await RefreshAsync();
    }

    private async Task ChangeCalendarAsync(string value)
    {
        if (busy || disposed) return;
        calendarId = value;
        events.Clear();
        NewEvent();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (busy || disposed) return;
        error = null;
        status = null;
        if (rangeEnd.Date < rangeStart.Date || rangeEnd.Year == 9999)
        {
            error = "Choose a valid date range with the last day on or after the first day.";
            return;
        }

        busy = true;
        try
        {
            if (calendars.Count == 0)
            {
                var result = await Workspace.ListCalendarsAsync(UserId);
                if (disposed) return;
                calendars = result.ToList();
                calendarId = (calendars.FirstOrDefault(calendar => calendar.Primary) ?? calendars.FirstOrDefault())?.Id ?? string.Empty;
            }
            if (!string.IsNullOrEmpty(calendarId))
            {
                var result = await Workspace.ListEventsAsync(UserId, calendarId, LocalIso(rangeStart.Date), LocalIso(rangeEnd.Date.AddDays(1)));
                if (disposed) return;
                events = result.ToList();
                loadedStart = rangeStart.Date;
                loadedEnd = rangeEnd.Date.AddDays(1);
                if (selectedEvent != null)
                {
                    var refreshed = events.FirstOrDefault(entry => entry.Id == selectedEvent.Id);
                    if (refreshed == null)
                    {
                        NewEvent();
                        status = "The selected event is no longer in this date range.";
                    }
                    else
                    {
                        SelectEvent(refreshed);
                        status = "Event details refreshed from Google Calendar.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            if (!disposed) error = ErrorMessage(ex);
        }
        finally
        {
            if (!disposed) busy = false;
        }
    }

    private void NewEvent()
    {
        selectedEvent = null;
        title = description = location = string.Empty;
        allDay = confirmDelete = false;
        startsAt = DateTime.Now.Date.AddHours(DateTime.Now.Hour + 1);
        endsAt = startsAt.AddHours(1);
        error = status = null;
    }

    private void SelectEvent(GoogleCalendarEvent entry)
    {
        selectedEvent = entry;
        title = entry.Summary;
        description = entry.Description ?? string.Empty;
        location = entry.Location ?? string.Empty;
        allDay = !string.IsNullOrEmpty(entry.Start.Date);
        startsAt = EventDate(entry.Start);
        endsAt = allDay ? EventDate(entry.End).AddDays(-1) : EventDate(entry.End);
        confirmDelete = false;
        error = status = null;
    }

    private async Task SaveAsync()
    {
        if (busy || disposed || !CanEdit) return;
        error = status = null;
        if (string.IsNullOrWhiteSpace(title))
        {
            error = "Enter an event title.";
            return;
        }
        if ((allDay && endsAt.Date < startsAt.Date) || (!allDay && endsAt <= startsAt) || endsAt.Year == 9999)
        {
            error = allDay ? "The last day must be on or after the first day." : "The end time must be later than the start time.";
            return;
        }
        if (!allDay && (TimeZoneInfo.Local.IsInvalidTime(startsAt) || TimeZoneInfo.Local.IsInvalidTime(endsAt)))
        {
            error = "That time falls within a daylight-saving clock change. Choose another time.";
            return;
        }

        busy = true;
        try
        {
            var body = new GoogleEventEdit
            {
                Summary = title.Trim(), Description = description, Location = location,
                Start = allDay ? new() { Date = startsAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) } : TimedValue(startsAt, selectedEvent?.Start),
                End = allDay ? new() { Date = endsAt.Date.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) } : TimedValue(endsAt, selectedEvent?.End)
            };
            var saved = await Workspace.SaveEventAsync(UserId, calendarId, selectedEvent?.Id, body, selectedEvent?.Etag);
            if (disposed) return;
            events.RemoveAll(entry => entry.Id == saved.Id);
            if (EventDate(saved.Start) < loadedEnd && EventDate(saved.End) > loadedStart) events.Add(saved);
            events = events.OrderBy(entry => EventDate(entry.Start)).ToList();
            SelectEvent(saved);
            status = "Event saved to Google Calendar.";
        }
        catch (Exception ex)
        {
            if (!disposed) error = ErrorMessage(ex);
        }
        finally
        {
            if (!disposed) busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (busy || disposed || selectedEvent == null || !CanEdit || !confirmDelete) return;
        busy = true;
        error = status = null;
        try
        {
            await Workspace.DeleteEventAsync(UserId, calendarId, selectedEvent.Id, selectedEvent.Etag);
            if (disposed) return;
            events.RemoveAll(entry => entry.Id == selectedEvent.Id);
            NewEvent();
            status = "Event deleted from Google Calendar.";
        }
        catch (Exception ex)
        {
            if (!disposed) error = ErrorMessage(ex);
        }
        finally
        {
            if (!disposed) busy = false;
        }
    }

    private static string LocalIso(DateTime value) => new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Local)).ToString("O", CultureInfo.InvariantCulture);

    private static GoogleEventTime TimedValue(DateTime value, GoogleEventTime? original) => original != null && !string.IsNullOrEmpty(original.DateTime) && EventDate(original) == value
        ? new() { DateTime = original.DateTime, TimeZone = original.TimeZone }
        : new() { DateTime = LocalIso(value) };

    private static DateTime EventDate(GoogleEventTime value) => !string.IsNullOrEmpty(value.Date)
        ? DateTime.ParseExact(value.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture)
        : DateTimeOffset.TryParse(value.DateTime, CultureInfo.InvariantCulture, DateTimeStyles.None, out var time) ? time.LocalDateTime : DateTime.MinValue;

    private static string EventWhen(GoogleCalendarEvent entry)
    {
        var start = EventDate(entry.Start);
        var end = EventDate(entry.End);
        if (!string.IsNullOrEmpty(entry.Start.Date))
        {
            var lastDay = end.AddDays(-1);
            return start == lastDay ? $"{start:d} · All day" : $"{start:d} – {lastDay:d} · All day";
        }
        return start.Date == end.Date ? $"{start:g} – {end:t}" : $"{start:g} – {end:g}";
    }

    private static string ErrorMessage(Exception exception) => exception is JSException
        ? exception.Message.Split('\n')[0]
        : "Google Calendar could not complete the request. Your changes are still in the form. Try again, or reconnect your account.";

    public void Dispose() => disposed = true;
}
