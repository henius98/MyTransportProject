@using MyTransportAppWASM.Models

<div class="card h-100">
  <div
    class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary border-opacity-10 pb-3">
    <div>
      <h3 class="m-0 fw-semibold" style="font-size: 1.15rem; letter-spacing: -0.01em;">@(Options?.Name ?? Provider?.Provider ?? "MetMalaysia")
      </h3>
      <a class="text-dim mt-1 d-inline-block" style="font-size: 0.75rem;" href="@($"https://{SourceDomain}")"
         target="_blank" rel="noopener noreferrer">
        <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@SourceDomain
      </a>
    </div>
    <WeatherStatusBadge Status="@(Provider?.Status ?? "Loading")" ProviderName="@(Options?.Name ?? Provider?.Provider ?? "MetMalaysia")"
                        IsCached="@(Provider?.IsCached == true)" IsRefreshing="isLoading" OnRefresh="RefreshAsync" />
  </div>

  @if (isLoading)
  {
    <div class="d-flex justify-content-center p-4">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>
  }
  else if (Provider?.Periods != null)
  {
    var groupedPeriods = Provider.Periods.GroupBy(p => MalaysiaTime.Convert(p.Time).Date);
    <div class="d-flex flex-column gap-3">
      @foreach (var group in groupedPeriods)
      {
        <div class="card flex-row shadow-sm border-secondary border-opacity-25"
             style="overflow: hidden; background: var(--bs-body-bg);">
          <time datetime="@group.Key.ToString("yyyy-MM-dd")"
                class="bg-secondary bg-opacity-10 py-3 px-2 px-sm-3 fw-semibold border-end border-secondary border-opacity-10 d-flex flex-column align-items-center flex-shrink-0 text-uppercase">
            <span>@group.Key.ToString("ddd")</span>
            <span class="fs-4 text-primary">@group.Key.ToString("dd")</span>
            <span>@group.Key.ToString("MMM")</span>
            <span class="small text-dim">@group.Key.ToString("yyyy")</span>
          </time>
          <div class="card-body forecast-periods p-0">
            @foreach (var slice in group)
            {
              bool isLast = ReferenceEquals(slice, group.Last());
              string labelColorClass = slice.Label switch
              {
                "Pagi" => "bg-success text-white",
                "Petang" => "bg-danger text-white",
                "Malam" => "bg-primary text-white",
                _ => "bg-secondary bg-opacity-25 text-body"
              };
              <div
                class="d-flex align-items-center p-2 p-sm-3 @(isLast ? "" : "border-bottom border-secondary border-opacity-10")">
                <div class="me-2 me-sm-4 fs-1" style="min-width: 3rem; text-align: center;">
                  <i class="@slice.Icon"></i>
                </div>
                <div class="forecast-details flex-grow-1">
                  <div class="fw-medium mb-1 fs-5" style="letter-spacing: -0.01em;">@(Language?[slice.Summary ?? "N/A"] ?? slice.Summary ?? "N/A")</div>

                  <div class="d-flex flex-wrap gap-3 text-dim fw-medium" style="font-size: 0.85rem;">
                    @if (slice.MinTemperatureC.HasValue && slice.MaxTemperatureC.HasValue)
                    {
                      <span class="text-danger"><i class="bi bi-thermometer-half me-1"></i>@($"{slice.MinTemperatureC:0.#}°C ~                {slice.MaxTemperatureC:0.#}°C")</span>
                    }
                    else if (slice.TemperatureC.HasValue)
                    {
                      <span class="text-danger"><i
                        class="bi bi-thermometer-half me-1"></i>@($"{slice.TemperatureC:0.#}°C")</span>
                      }
                      @if (!string.IsNullOrWhiteSpace(slice.Wind))
                      {
                        <span><i class="bi bi-wind me-1"></i>@slice.Wind</span>
                      }
                    </div>
                  </div>
                  @* @if (slice.Label != "Realtime" && slice.Label != "Outlook" &&
                    !string.IsNullOrWhiteSpace(slice.Label))
                  { *@
                  <span class="forecast-period-trigger ms-3 flex-shrink-0" tabindex="0" aria-label="@(Language?[slice.Label] ?? slice.Label)"
                        data-label="@(Language?[slice.Label] ?? slice.Label)">
                    <span class="badge forecast-period-label @labelColorClass" style="font-weight: 500;">
                      <span class="forecast-period-text">@(Language?[slice.Label] ?? slice.Label)</span>
                    </span>
                  </span>
                  @* } *@
                </div>
              }
            </div>
          </div>
        }
      </div>
    }
  </div>

@code {
  [CascadingParameter]
  private MyTransportAppWASM.Services.LanguageService Language { get; set; } = default!;

  [Parameter]
  public MetMalaysiaWeatherProviderOptions? Options { get; set; }

  [Parameter]
  public WeatherProviderResult? Result { get; set; }

  [Parameter]
  public EventCallback OnRefresh { get; set; }

  [Parameter]
  public bool IsRefreshing { get; set; }

  // If fetching realtime weather, just grab the closest time (handled by WeatherPlannerService shaping)
  private WeatherProviderResult? Provider => Result;
  private bool isLoading => IsRefreshing;
  private string SourceDomain => string.IsNullOrWhiteSpace(Options?.Source) ? (Provider?.Source ?? "data.gov.my") : Options.Source;

  private async Task RefreshAsync()
  {
    if (OnRefresh.HasDelegate)
    {
      await OnRefresh.InvokeAsync();
    }
  }
}
