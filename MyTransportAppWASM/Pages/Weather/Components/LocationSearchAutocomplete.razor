@using MyTransportAppWASM.Services.Interfaces
@using MyTransportAppWASM.Services
@inject IGeocodingService GeocodingService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="d-flex gap-2 align-items-center w-100">
  <div class="position-relative flex-grow-1">
    <input class="form-input w-100" id="@Id" @bind="_searchText" @bind:event="oninput" @bind:after="TriggerSearch"
           @onkeyup="HandleKeyUp" @onkeydown="HandleKeyDown" role="combobox"
           aria-expanded="@(_showSuggestions ? "true" : "false")" aria-controls="@ListboxId" aria-autocomplete="list"
           title="Try Langkawi, Ds001, or 6.37, 99.79. Coordinates use decimal degrees, latitude first."
           aria-activedescendant="@(_activeIndex >= 0 && _suggestions.Count > _activeIndex ? $"suggestion-{_activeIndex}" : null)"
           placeholder="Name, ID, or latitude, longitude" />

    @if (_showSuggestions)
    {
      <div class="position-absolute w-100 mt-1 p-0 shadow-sm"
           style="z-index: 1000; max-height: 250px; overflow-y: auto; background: var(--bg-color, #fff); border-radius: 12px; border: 1px solid var(--border-color); overflow-x: hidden;">
        <ul id="@ListboxId" class="list-unstyled m-0" role="listbox">
          @if (_isSearchingSuggestions && _suggestions.Count == 0)
          {
            <li class="p-2 text-muted" role="option" aria-disabled="true">Searching...</li>
          }
          else if (!_isSearchingSuggestions && _suggestions.Count == 0)
          {
            <li class="p-2 text-muted" role="option" aria-disabled="true">No matching location. Use a forecast name or ID,
              or valid latitude, longitude.</li>
            }
                else
            {
              @for (int i = 0; i < _suggestions.Count; i++)
              {
                var suggestion = _suggestions[i];
                int currentIndex = i;
                bool isActive = currentIndex == _activeIndex;

                <li id="suggestion-@currentIndex" class="p-2 border-bottom @(isActive ? "bg-light text-primary" : "")"
                    style="cursor: pointer;" role="option" aria-selected="@(isActive ? "true" : "false")"
                    @onclick="() => SelectSuggestion(suggestion)" @onmouseover="() => _activeIndex = currentIndex">
                  <strong>@suggestion.Name</strong><br />
                  <small class="@(isActive ? "text-primary opacity-75" : "text-dim")">@suggestion.FormattedAddress</small>
                </li>
              }
            }
          </ul>
        </div>
      }
    </div>

    <button type="button" class="btn btn--secondary btn--icon" @onclick="OpenMapModal" title="Select on Map"
            aria-label="Select on Map">
      <i class="bi bi-map" aria-hidden="true"></i>
    </button>
  </div>

  <dialog id="location-picker-modal" @ref="_mapDialog" aria-labelledby="map-modal-title" class="location-picker-dialog">
    <div class="d-flex flex-column h-100">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 id="map-modal-title" class="m-0" style="color: var(--text-color, #000);">Select a Location</h5>
        <form method="dialog">
          <button class="btn-close" aria-label="Close" @onclick="CloseMapModal"></button>
        </form>
      </div>

      <!-- Static map with selectable forecast locations -->
      <div class="location-picker-content">
        <label class="form-label" for="location-picker-search">Find a forecast location by name or ID</label>
        <input id="location-picker-search" class="form-input w-100" placeholder="e.g., Langkawi or Ds001"
               @bind="_mapSearch" @bind:event="oninput" />
        @if (_isLoadingMap)
        {
          <!-- Blazor loading status -->
          <div class="location-picker-status" role="status">Loading locations...</div>
        }
        else if (_mapLocations.Count == 0)
        {
          <div class="location-picker-status">No forecast locations are available.</div>
        }
        else
        {
          <p class="location-picker-hint">Select a dot or search for a location. Zoom with the buttons or mouse wheel, then
            drag to move the map.</p>
            <div class="location-picker-map" @ref="_mapViewport">
              <svg viewBox="0 0 1000 332" role="img" aria-label="Map of Malaysia showing forecast locations" @ref="_mapSvg">
                <image href="maps/malaysia-static-map.svg" width="1000" height="332" />
                <!-- Project forecast markers onto the SimpleMaps map -->
                @foreach (var location in FilteredMapLocations)
                {
                  <circle class="location-picker-dot" cx="@MapX(location.Longitude)" cy="@MapY(location.Latitude)" r="4.5"
                          data-location-name="@location.LocationName" @onclick="() => SelectMapLocation(location)" />
                }
              </svg>
              <div class="location-picker-zoom-controls" aria-label="Map zoom controls">
                <button type="button" aria-label="Zoom in" title="Zoom in" @onclick="() => ZoomMap(1.5)">+</button>
                <button type="button" aria-label="Zoom out" title="Zoom out" @onclick="() => ZoomMap(1 / 1.5)">−</button>
              </div>
              <div class="location-picker-tooltip" role="tooltip" hidden @ref="_mapTooltip"></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_mapSearch))
            {
              <ul class="location-picker-results" aria-label="Matching forecast locations">
                @foreach (var location in FilteredMapLocations.Take(15))
                {
                  <li><button type="button" @onclick="() => SelectMapLocation(location)">@location.LocationName
                    (@location.LocationId)</button></li>
                  }
                </ul>
                @if (FilteredMapLocations.Count == 0)
                {
                  <p class="location-picker-hint">No locations found.</p>
                }
              }
            }
          </div>
        </div>
      </dialog>

@code {
  [Parameter] public string? Id { get; set; }
  [Parameter] public string Value { get; set; } = string.Empty;
  [Parameter] public EventCallback<string> ValueChanged { get; set; }
  [Parameter]
  public EventCallback<(double Lat, double Lng, string FormattedAddress, string Name)> OnSuggestionSelected
  {
    get; set;
  }

  private string _searchText = string.Empty;
  private CancellationTokenSource? _debounceCts;
  private List<(double Lat, double Lng, string FormattedAddress, string Name)> _suggestions = new();
  private bool _showSuggestions = false;
  private bool _isSearchingSuggestions = false;

  private ElementReference _mapDialog;
  private ElementReference _mapViewport;
  private ElementReference _mapSvg;
  private ElementReference _mapTooltip;
  private bool _isLoadingMap = false;
  private bool _initializeMap;
  private List<GeocodingService.MetLocation> _mapLocations = new();
  private string _mapSearch = string.Empty;
  private IJSObjectReference? _mapModule;
  private bool _disposed;
  private string ListboxId => $"{Id ?? "location-search"}-listbox";
  // The source SVG's embedded calibration points map longitude and latitude to its 1000 x 332 viewBox.
  private static double MapX(double longitude) => 90.9 + (longitude - 100.62687099273207) * 46.30559021697878;
  private static double MapY(double latitude) => 302.2 - (latitude - 1.176590816028057) * 46.44711959017247;
  private List<GeocodingService.MetLocation> FilteredMapLocations =>
      string.IsNullOrWhiteSpace(_mapSearch)
          ? _mapLocations
          : _mapLocations.Where(location => location.LocationName?.Contains(_mapSearch.Trim(), StringComparison.OrdinalIgnoreCase)
== true
              || location.LocationId?.Contains(_mapSearch.Trim(), StringComparison.OrdinalIgnoreCase) == true).ToList();

  protected override void OnInitialized()
  {
    _searchText = Value;
  }

  protected override void OnParametersSet()
  {
    if (Value != _searchText)
    {
      _debounceCts?.Cancel();
      _showSuggestions = false;
      _searchText = Value;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_initializeMap && _mapModule != null)
    {
      _initializeMap = false;
      await _mapModule.InvokeVoidAsync("initializeMap", _mapSvg, _mapViewport, _mapTooltip);
    }
  }

  private async Task TriggerSearch()
  {
    await ValueChanged.InvokeAsync(_searchText);

    _debounceCts?.Cancel();
    _debounceCts?.Dispose();
    _debounceCts = new CancellationTokenSource();
    _suggestions.Clear();
    _activeIndex = -1;
    _isSearchingSuggestions = true;
    _showSuggestions = !string.IsNullOrWhiteSpace(_searchText);

    _ = DebounceSearchAsync(_searchText, _debounceCts.Token);
  }

  private async Task DebounceSearchAsync(string searchText, CancellationToken cancellationToken)
  {
    try
    {
      await Task.Delay(400, cancellationToken);

      if (string.IsNullOrWhiteSpace(searchText))
      {
        _suggestions.Clear();
        _isSearchingSuggestions = false;
        await InvokeAsync(StateHasChanged);
        return;
      }

      var results = await GeocodingService.GetSuggestionsAsync(searchText);
      cancellationToken.ThrowIfCancellationRequested();

      await InvokeAsync(() =>
      {
        _suggestions = results;
        _activeIndex = -1;
        _isSearchingSuggestions = false;
        StateHasChanged();
      });
    }
    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
    {
      // A newer keystroke superseded this search.
    }
    catch (Exception ex)
    {
      if (_disposed) return;

      Console.Error.WriteLine($"Location search failed: {ex.Message}");
      await InvokeAsync(() =>
      {
        _suggestions.Clear();
        _isSearchingSuggestions = false;
        StateHasChanged();
      });
    }
  }

  private int _activeIndex = -1;

  private async Task HandleKeyDown(KeyboardEventArgs e)
  {
    if (!_showSuggestions || _suggestions.Count == 0) return;

    if (e.Key == "ArrowDown")
    {
      _activeIndex = (_activeIndex + 1) % _suggestions.Count;
    }
    else if (e.Key == "ArrowUp")
    {
      _activeIndex = _activeIndex <= 0 ? _suggestions.Count - 1 : _activeIndex - 1;
    }
    else if (e.Key == "Enter" && _activeIndex >= 0 && _activeIndex < _suggestions.Count)
    {
      await SelectSuggestion(_suggestions[_activeIndex]);
    }
  }

  private async Task HandleKeyUp(KeyboardEventArgs e)
  {
    if (e.Key == "Enter" || e.Key == "Escape")
    {
      _showSuggestions = false;
    }
  }

  private async Task SelectSuggestion((double Lat, double Lng, string FormattedAddress, string Name) suggestion)
  {
    _debounceCts?.Cancel();
    _searchText = suggestion.Name;
    _showSuggestions = false;
    await ValueChanged.InvokeAsync(_searchText);
    await OnSuggestionSelected.InvokeAsync(suggestion);
  }

  private async Task OpenMapModal()
  {
    _isLoadingMap = true;
    _mapSearch = string.Empty;

    try
    {
      if (_mapModule == null)
      {
        _mapModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/locationPicker.js");
      }

      await _mapModule.InvokeVoidAsync("showDialog", _mapDialog);
      StateHasChanged();

      // Map the forecast coordinates directly onto the static SVG.
      _mapLocations = await GeocodingService.GetAllLocationsAsync();
    }
    catch (Exception ex)
    {
      Console.Error.WriteLine($"Failed to load locations: {ex.Message}");
    }
    finally
    {
      _isLoadingMap = false;
      _initializeMap = _mapLocations.Count > 0;
      StateHasChanged();
    }
  }

  private async Task ZoomMap(double factor)
  {
    if (_mapModule != null)
    {
      await _mapModule.InvokeVoidAsync("zoomMap", factor);
    }
  }

  private async Task CloseMapModal()
  {
    if (_mapModule != null)
    {
      await _mapModule.InvokeVoidAsync("disposeMap");
      await _mapModule.InvokeVoidAsync("closeDialog", _mapDialog);
    }
  }

  private async Task SelectMapLocation(GeocodingService.MetLocation location)
  {
    await CloseMapModal();
    await SelectSuggestion((location.Latitude, location.Longitude, $"MET ID: {location.LocationId}", location.LocationName
?? string.Empty));
  }

  public async ValueTask DisposeAsync()
  {
    _disposed = true;
    _debounceCts?.Cancel();
    _debounceCts?.Dispose();
    if (_mapModule != null)
    {
      try
      {
        await _mapModule.InvokeVoidAsync("disposeMap");
        await _mapModule.DisposeAsync();
      }
      catch (JSDisconnectedException) { }
    }
  }
}
