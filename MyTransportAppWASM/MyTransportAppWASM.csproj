<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <CompressionEnabled>true</CompressionEnabled>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <DebuggerSupport>true</DebuggerSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- GitHub Pages serves raw WASM rather than the generated compressed sidecars.
         The measured publish payload was 7.37 MB interpreted versus 29.17 MB full AOT,
         and the smaller build also reached the rendered Home page sooner. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmccLinkOptimizationFlag>-Oz</EmccLinkOptimizationFlag>
    <EmccEnvironment>web</EmccEnvironment>
    <DebuggerSupport>false</DebuggerSupport>
    <DynamicCodeSupport>false</DynamicCodeSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyTransportAppWASM.Tests" />
    <InternalsVisibleTo Include="MyTransportAppWASM.PerformanceBenchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTransportAppWASM.Core\MyTransportAppWASM.Core.csproj" />
    <ProjectReference Include="..\MyTransportAppWASM.Features\MyTransportAppWASM.Features.csproj" />
    <ProjectReference Include="..\MyTransportAppWASM.Gtfs\MyTransportAppWASM.Gtfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="MyTransportAppWASM.Features.dll" />
    <BlazorWebAssemblyLazyLoad Include="MyTransportAppWASM.Gtfs.dll" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\js\README.md" />
    <None Include="wwwroot\js\README.md" />
    <Content Remove="wwwroot\appsettings.Development.example.json" />
    <None Include="wwwroot\appsettings.Development.example.json" />
  </ItemGroup>

</Project>
