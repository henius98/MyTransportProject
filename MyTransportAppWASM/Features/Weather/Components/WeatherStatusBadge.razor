@if (IsCached)
{
  <button type="button"
          class="badge badge--action @GetStatusClass(Status)"
          disabled="@IsRefreshing"
          title="Refresh latest data from @ProviderName"
          aria-label="Refresh latest data from @ProviderName"
          aria-live="polite"
          @onclick="OnRefresh">
    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>@Status
  </button>
}
else
{
  <span class="badge @GetStatusClass(Status)" aria-live="polite">@Status</span>
}

@code {
  [Parameter]
  public string Status { get; set; } = "Loading";

  [Parameter]
  public string ProviderName { get; set; } = "weather provider";

  [Parameter]
  public bool IsCached { get; set; }

  [Parameter]
  public bool IsRefreshing { get; set; }

  [Parameter]
  public EventCallback OnRefresh { get; set; }

  public static string GetStatusClass(string? status) => WeatherUIHelper.GetStatusClass(status);
}
