<WeatherCardShell DefaultTitle="MetMalaysia"
                  DefaultSource="data.gov.my"
                  Result="Result"
                  IsRefreshing="IsRefreshing"
                  OnRefresh="OnRefresh">
  @if (Result?.Periods != null)
  {
    var groupedPeriods = Result.Periods.GroupBy(p => MalaysiaTime.Convert(p.Time).Date);
    <div class="d-flex flex-column gap-3">
      @foreach (var group in groupedPeriods)
      {
        var groupSlices = group.ToList();
        <div @key="group.Key" class="card panel-inset flex-row p-0" style="overflow: hidden;">
          <time datetime="@group.Key.ToString("yyyy-MM-dd")"
                class="py-3 px-2 px-sm-3 fw-bold d-flex flex-column align-items-center justify-content-center flex-shrink-0 text-uppercase"
                style="background: var(--accent-lavender); color: #1E1E1C; border-right: var(--hairline-dashed); font-family: var(--font-mono);">
            <span>@group.Key.ToString("ddd")</span>
            <span class="fs-4">@group.Key.ToString("dd")</span>
            <span>@group.Key.ToString("MMM")</span>
            <span class="small">@group.Key.ToString("yyyy")</span>
          </time>
          <div class="card-body forecast-periods p-0">
            @for (var i = 0; i < groupSlices.Count; i++)
            {
              var slice = groupSlices[i];
              bool isLast = i == groupSlices.Count - 1;
              string labelColorClass = slice.Label switch
              {
                "Pagi" => "bg-success text-dark",
                "Petang" => "bg-warning text-dark",
                "Malam" => "bg-primary text-dark",
                _ => "bg-secondary text-body"
              };
              <div @key="(slice.Time, slice.Label)"
                class="d-flex align-items-center p-2 p-sm-3"
                style="@(isLast ? "" : "border-bottom: var(--hairline-dashed);")">
                <div class="me-2 me-sm-4 fs-1" style="min-width: 3rem; text-align: center;">
                  <i class="@slice.Icon"></i>
                </div>
                <div class="forecast-details flex-grow-1">
                  <div class="fw-semibold mb-1 fs-5" style="letter-spacing: -0.01em;">@(Language?[slice.Summary ?? "N/A"] ?? slice.Summary ?? "N/A")</div>

                  <div class="d-flex flex-wrap gap-3 text-dim fw-medium tabular-nums" style="font-family: var(--font-mono); font-size: 0.82rem;">
                    @if (slice.MinTemperatureC.HasValue && slice.MaxTemperatureC.HasValue)
                    {
                      <span class="text-danger fw-bold"><i class="bi bi-thermometer-half me-1"></i>@($"{slice.MinTemperatureC:0.#}°C ~ {slice.MaxTemperatureC:0.#}°C")</span>
                    }
                    else if (slice.TemperatureC.HasValue)
                    {
                      <span class="text-danger fw-bold"><i class="bi bi-thermometer-half me-1"></i>@($"{slice.TemperatureC:0.#}°C")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(slice.Wind))
                    {
                      <span><i class="bi bi-wind me-1"></i>@slice.Wind</span>
                    }
                  </div>
                </div>
                <span class="forecast-period-trigger ms-3 flex-shrink-0" tabindex="0" aria-label="@(Language?[slice.Label] ?? slice.Label)"
                      data-label="@(Language?[slice.Label] ?? slice.Label)">
                  <span class="badge forecast-period-label @labelColorClass">
                    <span class="forecast-period-text">@(Language?[slice.Label] ?? slice.Label)</span>
                  </span>
                </span>
              </div>
            }
          </div>
        </div>
      }
    </div>
  }
</WeatherCardShell>

@code {
  [CascadingParameter]
  private LanguageService Language { get; set; } = default!;

  [Parameter]
  public WeatherProviderResult? Result { get; set; }

  [Parameter]
  public EventCallback OnRefresh { get; set; }

  [Parameter]
  public bool IsRefreshing { get; set; }
}
