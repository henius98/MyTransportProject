
@if (TransportProviders.Any(provider => provider.HasStaticData))
{
    <div class="static-routes mt-3">
        <h3 class="fs-6 mb-2">@(Language?["StaticRoutesHeading"] ?? "Routes and estimated departures")</h3>
        <label class="form-label" for="static-provider-select">@(Language?["ProviderLabel"] ?? "Provider")</label>
        <select id="static-provider-select" name="staticProvider" class="form-input" value="@SelectedProviderIndex" @onchange="OnProviderChanged">
            <option value="-1">@(Language?["ChooseProviderOption"] ?? "Choose a provider")</option>
            @for (var index = 0; index < TransportProviders.Count; index++)
            {
                if (TransportProviders[index].HasStaticData)
                {
                    <option value="@index">@TransportProviders[index].Name</option>
                }
            }
        </select>
        @if (HasSelectedStaticData)
        {
            <label class="form-label mt-2" for="static-route-select">@(Language?["RouteLabel"] ?? "Route")</label>
            <select id="static-route-select" name="staticRoute" class="form-input" value="@SelectedRouteId" @onchange="OnRouteChanged" disabled="@(Routes.Count == 0)">
                <option value="">@(Language?["AllRoutesOption"] ?? "All routes")</option>
                @foreach (var route in Routes)
                {
                    var shortName = string.IsNullOrWhiteSpace(route.RouteShortName) ? route.RouteId : route.RouteShortName;
                    <option @key="route.RouteId" value="@route.RouteId">@(string.IsNullOrWhiteSpace(route.RouteLongName) ? shortName : $"{shortName} ({route.RouteLongName})")</option>
                }
            </select>
            <div class="@(IsErrorStatus ? "tracker-status tracker-status--error mt-2" : "small mt-2")"
                 role="@(IsErrorStatus ? "alert" : "status")"
                 aria-live="@(IsErrorStatus ? "assertive" : "polite")">
                @if (IsErrorStatus)
                {
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
                }
                <span>@Status</span>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter]
    private LanguageService? Language { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<TransportProvider> TransportProviders { get; set; } = [];

    [Parameter]
    public int SelectedProviderIndex { get; set; } = -1;

    [Parameter]
    public bool HasSelectedStaticData { get; set; }

    [Parameter]
    public string SelectedRouteId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<StaticRoute> Routes { get; set; } = [];

    [Parameter]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public bool IsErrorStatus { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnProviderChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnRouteChanged { get; set; }
}
