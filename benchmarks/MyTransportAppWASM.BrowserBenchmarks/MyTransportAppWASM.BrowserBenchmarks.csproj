<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmOptimizationPreference>Speed</WasmOptimizationPreference>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
                      Version="10.0.7"
                      PrivateAssets="all" />
    <ProjectReference Include="../../MyTransportAppWASM.Gtfs/MyTransportAppWASM.Gtfs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../MyTransportAppWASM/Models/TransportModels.cs"
             Link="Production/Models/TransportModels.cs" />
    <Compile Include="../../MyTransportAppWASM/Models/WeatherModels.cs"
             Link="Production/Models/WeatherModels.cs" />
    <Compile Include="../../MyTransportAppWASM/Services/Interfaces/ILiveRoutingService.cs"
             Link="Production/Services/Interfaces/ILiveRoutingService.cs" />
    <Compile Include="../../MyTransportAppWASM/Services/LiveRoutingService.cs"
             Link="Production/Services/LiveRoutingService.cs" />
    <Compile Include="../../MyTransportAppWASM/Utils/WeatherShaper.cs"
             Link="Production/Utils/WeatherShaper.cs" />
  </ItemGroup>

</Project>
