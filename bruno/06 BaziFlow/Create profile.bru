meta {
  name: Create profile
  type: http
  seq: 2
}

post {
  url: {{bazi_base_url}}/api/v1/profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bazi_api_key}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {"gender":1,"birthDate":"{{birth_date}}","birthHour":12,"birthMinute":30,"location":"{{birth_location}}"}
}

docs {
  Matches the Blazor CreateProfileRequest JSON shape. Creates or replaces the profile.
}
