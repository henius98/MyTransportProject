meta {
  name: Rapid Bus Penang
  type: http
  seq: 1
}

get {
  url: {{data_gov_base}}/gtfs-realtime/vehicle-position/prasarana/?category=rapid-bus-penang
  body: none
  auth: none
}

docs {
  Vehicle positions from appsettings.json. Response is binary GTFS Realtime Protocol Buffers; use Download in Bruno to save it.
  The app polls with conditional If-None-Match and If-Modified-Since after receiving validators.
}
